#!/bin/bash

set -x
set -e

IMAGE="${IMAGE_ID}-${IMAGE_VERSION}.${ARCHITECTURE}"
IMAGE_FULL="${IMAGE_ID}-${IMAGE_VERSION}.${ARCHITECTURE}.img"

echo "mkosi.postoutput ${IMAGE}" "$@"

SCRIPTS_DIR="scripts"
# Hack for OBS: it redefines the directories
if [ -d mkosi.output ]; then
	MKOSI_OUTPUT="$PWD/mkosi.output"
else
        MKOSI_OUTPUT="/usr/src/packages/OTHER"
fi
BOOTLOADER_DIR="${MKOSI_OUTPUT}/bootloader"

RDII_VERSION=$(rpm --root "${BOOTLOADER_DIR}" -q --qf '%{VERSION}' rdi-installer)
# Could be in the form of "1.0.0+git20260923.8f88a3f"
RDII_VERSION="${RDII_VERSION%+*}"

# shim + systemd-boot
echo "Building ${IMAGE_FULL}"
case $ARCHITECTURE in
    x86-64|arm64)
        KERNEL_VERSION=$(get_kernel_version "${OUTPUTDIR}/${IMAGE}.vmlinuz")
        TEMPDIR=$(mktemp -d)
        cat <<EOF > "${TEMPDIR}/loader.conf"
timeout  5
#console-mode keep
EOF
        cat <<EOF > "${TEMPDIR}/rdii-image.conf"
title   Raw Disk Image Installer ${RDII_VERSION}-${IMAGE_VERSION}
version 1@$KERNEL_VERSION
options quiet systemd.show_status=yes
linux   /${KERNEL_VERSION}/linux
initrd  /${KERNEL_VERSION}/initrd
EOF
        # create images
	"${SCRIPTS_DIR}/create_uefi_usbstick.sh" "${OUTPUTDIR}/${IMAGE_FULL}"
        # copy files to image
        mmd -i "${OUTPUTDIR}/${IMAGE_FULL}"@@1048576 EFI EFI/BOOT loader loader/entries "$KERNEL_VERSION"
	if [ "$ARCHITECTURE" == "x86-64" ]; then
	    mcopy -i "${OUTPUTDIR}/${IMAGE_FULL}"@@1048576 "${BOOTLOADER_DIR}/usr/share/efi/x86_64/shim.efi" ::EFI/BOOT/BOOTX64.EFI
	    mcopy -i "${OUTPUTDIR}/${IMAGE_FULL}"@@1048576 "${BOOTLOADER_DIR}/usr/share/efi/x86_64/MokManager.efi" ::EFI/BOOT/MokManager.efi
	    mcopy -i "${OUTPUTDIR}/${IMAGE_FULL}"@@1048576 "${BOOTLOADER_DIR}/usr/lib/systemd/boot/efi/systemd-bootx64.efi" ::EFI/BOOT/grub.efi
	else
	    mcopy -i "${OUTPUTDIR}/${IMAGE_FULL}"@@1048576 "${BOOTLOADER_DIR}/usr/share/efi/aarch64/shim.efi" ::EFI/BOOT/BOOTAA64.EFI
	    mcopy -i "${OUTPUTDIR}/${IMAGE_FULL}"@@1048576 "${BOOTLOADER_DIR}/usr/share/efi/aarch64/MokManager.efi" ::EFI/BOOT/MokManager.efi
	    mcopy -i "${OUTPUTDIR}/${IMAGE_FULL}"@@1048576 "${BOOTLOADER_DIR}/usr/lib/systemd/boot/efi/systemd-bootaa64.efi" ::EFI/BOOT/grub.efi
	fi
        mcopy -i "${OUTPUTDIR}/${IMAGE_FULL}"@@1048576 "${TEMPDIR}/loader.conf" ::loader/loader.conf
	rm "${TEMPDIR}/loader.conf"
	# kernel + initrd
        mcopy -i "${OUTPUTDIR}/${IMAGE_FULL}"@@1048576 "${TEMPDIR}/rdii-image.conf" ::loader/entries/rdii-image.conf
        rm "${TEMPDIR}/rdii-image.conf"
        mcopy -i "${OUTPUTDIR}/${IMAGE_FULL}"@@1048576 "${OUTPUTDIR}/${IMAGE}.vmlinuz" ::"${KERNEL_VERSION}/linux"
        mcopy -i "${OUTPUTDIR}/${IMAGE_FULL}"@@1048576 "${OUTPUTDIR}/${IMAGE}.initrd" ::"${KERNEL_VERSION}/initrd"
	# compress rdi-installer.img
	xz -z "${OUTPUTDIR}/${IMAGE_FULL}"
	rm -rf "$TEMPDIR"
	;;
    *)
        echo "Unsupported architecture: '$ARCHITECTURE'" >&2
        echo "No raw disk image will be generated." >&2
esac


# cleanup
rm -v "${OUTPUTDIR}/${IMAGE}"
rm -v "${OUTPUTDIR}/${IMAGE}.initrd"
rm -v "${OUTPUTDIR}/${IMAGE}.vmlinuz"
# OBS maps that read-only
if [ -w "${BOOTLOADER_DIR}" ]; then
	rm -rf "${BOOTLOADER_DIR}" ||:
fi
