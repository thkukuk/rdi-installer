[Unit]
Description=Import gpg public key(s) from Kernel Command Line or config file
After=local-fs.target
After=network-online.target
Wants=network-online.target
After=rdii-fetch-config.service
Before=getty.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/rdii-pubkey-setup

[Install]
WantedBy=multi-user.target
