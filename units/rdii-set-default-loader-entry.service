[Unit]
Description=Set LoaderEntryDefault to booted entry
Documentation=man:rdii-helper(8)

# On systems with read-only root filesystem, every
# update will set the default boot loader entry.
ConditionPathIsReadWrite=/
ConditionFirstBoot=yes
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=rdii-helper set-default-loader-entry

[Install]
WantedBy=multi-user.target
